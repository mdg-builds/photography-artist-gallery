# Postgres connection string (Vercel Postgres / Neon). Use the pooled URL for
# the app and, if your provider gives you a separate direct/non-pooling URL,
# put that in DIRECT_URL for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL=""

# Vercel Blob (Storage tab in your Vercel project -> Create Blob store).
# Leave unset in local dev to fall back to saving uploads under public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Long random string used to sign admin session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Seeds the initial admin account (only used the first time you run `npm run db:seed`).
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-immediately"

# Your real domain once deployed (used for social-share previews/OG image URLs).
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
