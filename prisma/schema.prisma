generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Photo {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  imageUrl  String
  titleEn   String
  titleEs   String
  descEn    String   @db.Text
  descEs    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bio {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  imageUrl  String?
  name      String
  roleEn    String
  roleEs    String
  bodyEn    String   @db.Text
  bodyEs    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row (id always 1) holding the editable site-wide copy.
model SiteContent {
  id             Int      @id @default(1)
  brand          String   @default("Sin Pedir Permiso")
  heroSubtitleEn String   @default("")
  heroSubtitleEs String   @default("")
  heroCreditEn   String   @default("")
  heroCreditEs   String   @default("")
  heroImageUrl   String?
  statementEn    String   @default("") @db.Text
  statementEs    String   @default("") @db.Text
  footerCreditEn String   @default("")
  footerCreditEs String   @default("")
  updatedAt      DateTime @updatedAt
}
